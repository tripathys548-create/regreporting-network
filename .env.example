# PostgreSQL connection string
DATABASE_URL="postgresql://localhost:5432/regreporting?schema=public"
# Secret for hashing email verification codes. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Password for the seeded demo account (demo@regreporting.network)
SEED_DEMO_PASSWORD=""

# Email — Gmail SMTP with an App Password. Leave SMTP_PASS empty to use /dev/mailbox instead.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="support.websitecreation@gmail.com"
SMTP_PASS=""
# EMAIL_FROM can be a bare address or a full "Name <address>" string. Only set EMAIL_FROM_NAME
# if EMAIL_FROM is a bare address — setting both would double-wrap the From header.
EMAIL_FROM="RegReporting Network <support.websitecreation@gmail.com>"
EMAIL_FROM_NAME=""

# Absolute site origin, used to build links inside emails (confirm, unsubscribe, CTAs).
SITE_URL="https://regworldcommsind.webelvate.com"

# Optional, paid: RegBot live answers (Claude). Leave empty to use the free prewritten reference answers.
ANTHROPIC_API_KEY=""
# Optional model override (default: claude-opus-5)
REGBOT_MODEL=""

# Online presence: minutes since the last heartbeat before a member drops out of the online count.
# See docs/PRESENCE.md. Every rate limit in lib/security/config.ts (presence, sharing, notification
# preferences, admin announcements, etc.) is also env-overridable — see that file for the full list.
PRESENCE_ONLINE_WINDOW_MINUTES="5"

# Bearer token for the Argus agent (weekly newsletter) — /api/agent/* is disabled until set (min 32 chars)
AGENT_API_TOKEN=""
