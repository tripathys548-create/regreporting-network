# PostgreSQL connection string
DATABASE_URL="postgresql://localhost:5432/regreporting?schema=public"
# Secret for hashing email verification codes. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Password for the seeded demo account (demo@regreporting.network)
SEED_DEMO_PASSWORD=""

# Email — Gmail SMTP with an App Password. Leave SMTP_PASS empty to use /dev/mailbox instead.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="support.websitecreation@gmail.com"
SMTP_PASS=""
EMAIL_FROM="RegReporting Network <support.websitecreation@gmail.com>"

# Optional, paid: RegBot live answers (Claude). Leave empty to use the free prewritten reference answers.
ANTHROPIC_API_KEY=""
# Optional model override (default: claude-opus-5)
REGBOT_MODEL=""
