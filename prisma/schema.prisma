// PostgreSQL. Enum-like fields stay as strings validated in lib/validation.ts and
// lib/services so domain values such as "pending-review" are stored verbatim.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  role            String    @default("member") // member | moderator | admin
  status          String    @default("active") // pending | active | suspended
  suspendedAt     DateTime?
  suspendedReason String?
  lastLoginAt     DateTime?
  /// Updated by POST /api/presence/heartbeat (~every 60s while a tab is open). Aggregate-only —
  /// never exposed per-user; see docs/PRESENCE.md.
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Set once, the first time the one-time welcome email is sent after signup. Guards against
  /// re-sending on login, profile updates or re-verification; an admin resend bypasses the guard.
  welcomeEmailSentAt    DateTime?
  welcomeEmailSentCount Int       @default(0)

  profile                    Profile?
  sessions                   Session[]
  verifications              EmailVerification[]
  discussions                Discussion[]
  comments                   Comment[]
  discussionVotes            DiscussionVote[]
  commentVotes               CommentVote[]
  savedDiscussions           SavedDiscussion[]
  follows                    UserFollow[]
  notifications              Notification[]
  notificationPreference     NotificationPreference?
  reports                    ContentReport[]
  auditLogs                  AuditLog[]
  suggestions                Suggestion[]
  suggestionVotes            SuggestionVote[]
  newsletterSubscriptions    NewsletterSubscription[]
  newsletterCampaignsCreated NewsletterCampaign[]
  shareEvents                ShareEvent[]
}

model Profile {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle               String   @unique
  displayName          String
  jobTitle             String
  organisationName     String
  organisationType     String
  yearsExperience      Int
  location             String   @default("")
  bio                  String   @default("")
  expertise            String[] @default([])
  verifiedPractitioner Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Log of every email. Bodies are only kept when the message was NOT delivered via SMTP (development mailbox).
model OutboundEmail {
  id         String   @id @default(cuid())
  to         String
  subject    String
  body       String   @default("")
  status     String   @default("logged") // logged | sent | failed
  error      String?
  /// welcome | verification | newsletter-confirmation | newsletter-campaign | other — lets admin
  /// analytics filter sent/delivered/failed counts per email type without matching on subject text.
  category   String   @default("other")
  campaignId String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([campaignId])
}

/// A newsletter subscription, independent of account creation (item 22: account creation must
/// never imply marketing consent). Linked to a User when the subscriber is a member; anonymous
/// subscribers keep userId null. Double opt-in: status stays "pending" until the confirmation
/// link is clicked.
model NewsletterSubscription {
  id     String  @id @default(cuid())
  email  String  @unique
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  status        String @default("pending") // pending | active | unsubscribed
  consentSource String // signup | homepage | footer | regulatory-radar | knowledge-base | challenges | admin

  subscribedAt   DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  /// Single-use, time-limited: consumed (nulled) once the double opt-in link is clicked.
  confirmationTokenHash      String?   @unique
  confirmationTokenExpiresAt DateTime?

  // The one-click unsubscribe link needs to work indefinitely across every future campaign send,
  // so unlike the confirmation token it is not stored at all — it's an HMAC of this row's id under
  // AUTH_SECRET (lib/newsletter/tokens.ts), recomputed on demand and never persisted.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events NewsletterEvent[]

  @@index([status])
  @@index([userId])
}

/// Admin-authored weekly newsletter content and send lifecycle.
model NewsletterCampaign {
  id          String @id @default(cuid())
  title       String
  subject     String
  previewText String @default("")

  introText          String @default("")
  radarHighlight     String @default("")
  knowledgeHighlight String @default("")
  challengeHighlight String @default("")
  communityHighlight String @default("")
  milestoneHighlight String @default("")
  ctaLabel           String @default("Visit RegWorld")
  ctaUrl             String @default("/")

  status      String    @default("draft") // draft | scheduled | sent
  scheduledAt DateTime?
  sentAt      DateTime?
  sentCount   Int       @default(0)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events NewsletterEvent[]

  @@index([status, createdAt])
}

/// Self-hosted open/click tracking, independent of the SMTP provider (which has no webhooks).
model NewsletterEvent {
  id             String                 @id @default(cuid())
  campaignId     String
  campaign       NewsletterCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   NewsletterSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type           String // sent | opened | clicked
  url            String?
  createdAt      DateTime               @default(now())

  @@index([campaignId, type])
  @@index([subscriptionId])
}

/// Singleton row (fixed id) controlling automatic weekly sending. Admin must explicitly enable it.
model NewsletterSettings {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(false)
  sendDay   Int      @default(1) // 0 = Sunday .. 6 = Saturday
  sendTime  String   @default("09:00") // HH:mm, UTC
  updatedAt DateTime @updatedAt
}

model Discussion {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  body              String
  authorId          String
  author            User      @relation(fields: [authorId], references: [id])
  category          String
  tags              String[]  @default([])
  status            String    @default("published") // published | pending-review | removed
  origin            String    @default("member")
  viewCount         Int       @default(0)
  voteScore         Int       @default(0)
  replyCount        Int       @default(0)
  acceptedCommentId String?
  removedAt         DateTime?
  removedReason     String?
  createdAt         DateTime  @default(now())
  lastActivityAt    DateTime  @default(now())

  comments Comment[]
  votes    DiscussionVote[]
  saves    SavedDiscussion[]

  @@index([status, category])
  @@index([authorId])
  @@index([lastActivityAt])
}

model Comment {
  id                     String     @id @default(cuid())
  discussionId           String
  discussion             Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parentId               String?
  authorId               String
  author                 User       @relation(fields: [authorId], references: [id])
  body                   String
  voteScore              Int        @default(0)
  isAccepted             Boolean    @default(false)
  knowledgeBaseCandidate Boolean    @default(false)
  status                 String     @default("published") // published | removed
  removedAt              DateTime?
  removedReason          String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  votes CommentVote[]

  @@index([discussionId, createdAt])
  @@index([authorId])
}

model DiscussionVote {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  value        Int        @default(1)
  createdAt    DateTime   @default(now())

  @@id([userId, discussionId])
}

model CommentVote {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  value     Int      @default(1)
  createdAt DateTime @default(now())

  @@id([userId, commentId])
}

model SavedDiscussion {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, discussionId])
}

model UserFollow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation(fields: [followerId], references: [id], onDelete: Cascade)
  targetType String // user | discussion | source | topic
  targetId   String
  createdAt  DateTime @default(now())

  @@unique([followerId, targetType, targetId])
  @@index([targetType, targetId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Per-user notification delivery preferences. One row per user, created on first
/// write (see lib/repositories/notifications.ts). In-app toggles gate the fan-out
/// notification creators in lib/services/community.ts; emailDigest reuses the
/// existing OutboundEmail/SMTP pipeline — no new provider. No WhatsApp field: the
/// spec explicitly withholds that until a provider is configured.
model NotificationPreference {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies             Boolean  @default(true)
  mentions            Boolean  @default(true)
  followedDiscussions Boolean  @default(true)
  followedTopics      Boolean  @default(true)
  regulatoryUpdates   Boolean  @default(true)
  knowledgeArticles   Boolean  @default(true)
  challenges          Boolean  @default(true)
  adminAnnouncements  Boolean  @default(true)
  emailDigest         Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

/// Telemetry for the ShareButton (§24: content type, content id, method, timestamp,
/// authenticated user where available). Aggregate/operational only — never rendered
/// per-viewer, and userId is nullable so anonymous shares are captured too.
model ShareEvent {
  id          String   @id @default(cuid())
  contentType String // discussion | regulatory-update | knowledge-article
  contentId   String
  method      String // copy-link | whatsapp | linkedin | email | x | native-share
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([contentType, contentId])
  @@index([createdAt])
}

model ContentReport {
  id           String    @id @default(cuid())
  targetType   String // discussion | comment | profile
  targetId     String
  reporterId   String
  reporter     User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String
  detail       String    @default("")
  status       String    @default("open") // open | actioned | dismissed
  resolvedAt   DateTime?
  resolvedById String?
  resolution   String?
  createdAt    DateTime  @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

/// Regulatory updates — ingested from official feeds or entered by an admin. Nothing is public until approved.
model RegulatoryUpdate {
  id             String    @id @default(cuid())
  sourceId       String // key into the trusted-source registry (data/sources.ts)
  title          String
  summary        String
  category       String
  topics         String[]  @default([])
  jurisdiction   String
  publishedAt    DateTime
  originalUrl    String    @unique
  severity       String    @default("standard") // critical | high | standard
  isAlert        Boolean   @default(false)
  status         String    @default("pending-review") // pending-review | published | rejected | archived
  isDemo         Boolean   @default(false)
  relevanceScore Int       @default(0)
  ingestedFrom   String?
  externalId     String?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([sourceId, publishedAt])
}

model SourceFeed {
  id            String    @id
  sourceId      String
  label         String
  url           String
  enabled       Boolean   @default(true)
  lastFetchedAt DateTime?
  lastStatus    String? // ok | error
  lastError     String?
  lastItemCount Int       @default(0)

  runs IngestionRun[]
}

model IngestionRun {
  id            String     @id @default(cuid())
  feedId        String
  feed          SourceFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  status        String     @default("running") // running | ok | error
  triggeredById String?
  fetched       Int        @default(0)
  pending       Int        @default(0)
  archived      Int        @default(0)
  duplicates    Int        @default(0)
  skippedOld    Int        @default(0)
  rejected      Int        @default(0)
  error         String?
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?

  @@index([feedId, startedAt])
}

/// Every staff action (approvals, removals, suspensions, role changes) AND every
/// admin security action (restrictions, event review). requestId ties an audit
/// row back to the request/security event that triggered it.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String
  detail     String   @default("")
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

/// Raw security telemetry: auth failures, rate-limit trips, abuse-pattern hits, etc.
/// Never store secrets, tokens, or full request bodies here — see lib/security/logger.ts.
model SecurityEvent {
  id           String   @id @default(cuid())
  requestId    String
  eventType    String // e.g. MULTIPLE_LOGIN_FAILURES, RATE_LIMIT_EXCEEDED, REGBOT_ABUSE, SSRF_BLOCKED
  category     String // authentication | api-abuse | regbot-abuse | community-abuse | admin-security | infrastructure | data-security | application-error
  severity     String // low | medium | high | critical
  riskScore    Int      @default(0)
  route        String   @default("")
  ip           String   @default("")
  userId       String?
  detail       String   @default("") // short, non-sensitive summary only
  status       String   @default("open") // open | reviewed | resolved
  reviewedById String?
  reviewNote   String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([category, severity, createdAt])
  @@index([userId])
}

/// Aggregated alert surfaced to admins — one row can represent many underlying
/// SecurityEvent rows (see lib/security/alerts.ts dedup/aggregation window).
model SecurityAlert {
  id             String   @id @default(cuid())
  category       String
  severity       String
  title          String
  summary        String
  occurrences    Int      @default(1)
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  status         String   @default("open") // open | investigating | resolved | escalated
  assignedToId   String?
  resolutionNote String?
  createdAt      DateTime @default(now())

  @@index([status, severity, createdAt])
  @@index([category, lastSeenAt])
}

/// Temporary restriction on a user or a source (IP/session), applied by an admin
/// or by automated progressive controls. Enforced in lib/security/restrictions.ts.
model SecurityRestriction {
  id          String    @id @default(cuid())
  targetType  String // user | source
  targetId    String // userId, or an IP/session key for "source"
  level       String // watch | rate-limited | challenge | restricted
  reason      String    @default("")
  createdById String?
  expiresAt   DateTime
  liftedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([targetType, targetId, expiresAt])
}

/// User-submitted improvement/bug suggestions, including the "Security" category.
model Suggestion {
  id               String   @id @default(cuid())
  authorId         String
  author           User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title            String
  description      String
  category         String // feature | bug | security | content | other
  priority         String   @default("normal") // low | normal | high
  relatedPage      String   @default("")
  screenshotUrl    String?
  severity         String? // security category only: low | medium | high | critical
  stepsToReproduce String   @default("")
  status           String   @default("open") // open | under-review | planned | in-progress | shipped | declined | duplicate
  ownerId          String?
  adminNotes       String   @default("")
  targetRelease    String   @default("")
  voteCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  votes SuggestionVote[]

  @@index([status, category, createdAt])
}

model SuggestionVote {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  suggestionId String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([userId, suggestionId])
}
